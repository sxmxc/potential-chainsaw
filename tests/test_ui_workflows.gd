extends "res://tests/support/scene_test.gd"

func settle() -> void:
	for i in 4: await get_tree().process_frame

func test_campaign_ui_scene_lifecycle() -> void:
	var game: Node = load("res://scenes/main.tscn").instantiate()
	var hud: Control = game.get_node("%HUD")
	var authoring: PanelContainer = hud.get_node("%PuzzleAuthoring")
	var toolbar: HBoxContainer = hud.get_node("%FileToolbar")
	var puzzle_bar: PanelContainer = toolbar.get_node("%PuzzleBar")
	var browser: Window = game.get_node("%PuzzleBrowser")
	var completion: Window = game.get_node("%PuzzleCompletion")
	assert_false(authoring.visible, "Saved authoring drawer starts closed")
	assert_false(puzzle_bar.visible, "Saved test actions start hidden")
	assert_false(browser.visible, "Saved campaign browser starts closed")
	assert_false(completion.visible, "Saved completion window starts closed")
	add_child_autoqfree(game)
	var session: PuzzleSession = game.puzzle_session
	assert_eq(game.get_node("PuzzleSession"), session)
	game.handle_action("sandbox")
	assert_false(puzzle_bar.visible)
	game.handle_action("campaign")
	assert_true(browser.visible)
	assert_false(game.sandbox.build.enabled, "Campaign browser blocks editing")
	browser.close()
	assert_true(game.sandbox.build.enabled, "Closing browser restores editing")
	session.editor(session.store.list_puzzles()[0])
	toolbar.get_node("%Author").pressed.emit()
	assert_true(authoring.visible, "Toolbar opens the saved authoring drawer")
	assert_true(session.test_player())
	assert_false(authoring.visible, "Entering player test closes authoring")
	assert_true(puzzle_bar.visible, "Player test exposes solution actions")
	puzzle_bar.get_node("%ReturnEditor").pressed.emit()
	assert_eq(session.mode, "editor", "Return action restores the authored session")
	assert_false(puzzle_bar.visible)
	game.new_track()
	assert_eq(session.mode, "sandbox")
	assert_false(authoring.visible)
	assert_false(puzzle_bar.visible)

func test_draft_player_hud_fits_small_windows() -> void:
	var game = load("res://scenes/main.tscn").instantiate()
	add_child_autoqfree(game)
	var browser: Window = game.get_node("%PuzzleBrowser")
	var puzzle_bar: PanelContainer = game.get_node("%HUD").get_node("%FileToolbar").get_node("%PuzzleBar")
	var session: PuzzleSession = game.puzzle_session
	var drafts: Array = session.store.list_puzzles(true).filter(func(data): return str(data.id).begins_with("chapter1-"))
	assert_eq(drafts.size(), 3)
	for dimensions in [Vector2i(1024, 720), Vector2i(1280, 720)]:
		game.qa_resolution(dimensions.x, dimensions.y)
		for data in drafts:
			session.editor(data)
			await settle()
			var toolbar: Control = game.get_node("%HUD").get_node("%FileToolbar")
			var open_button: Button = toolbar.get_node("%Open")
			assert_true(open_button.visible and open_button.icon != null, "Editor exposes a recognizable Open action")
			assert_eq(open_button.get_index() + 1, toolbar.get_node("%Save").get_index(), "Open sits beside Save")
			assert_true(Rect2(Vector2.ZERO, Vector2(dimensions)).grow(0.5).encloses(toolbar.get_global_rect()), "Editor toolbar fits the window")
			open_button.pressed.emit()
			assert_true(browser.visible and browser.editing, "Open goes directly to the editor puzzle library")
			browser.close()
			assert_true(session.test_player())
			await settle()
			assert_false(open_button.visible, "Player tests do not expose draft loading")
			var hud: Control = game.get_node("%HUD")
			var viewport := Rect2(Vector2.ZERO, Vector2(dimensions))
			for control: Control in [hud, hud.get_node("%FileToolbar"), hud.get_node("%Toolbox"), hud.get_node("%BuildToolbar"), puzzle_bar]:
				assert_true(viewport.grow(0.5).encloses(control.get_global_rect()), data.name + " keeps " + control.name + " inside " + str(dimensions))
			assert_lt(puzzle_bar.size.y, 60.0, "Test actions stay in one compact toolbar row")
			assert_not_null(puzzle_bar.get_node("%ReturnEditor").icon)
			assert_false(puzzle_bar.get_node("%SolutionActions").get_popup().visible, "References stay behind an explicit menu action")
			session.return_editor()

func test_ui_workflows() -> void:
	get_tree().root.size=Vector2i(1280,720)
	var game=load("res://scenes/main.tscn").instantiate()
	add_child_autoqfree(game)
	game.qa_resolution(1280,720)
	await settle()
	var hud=game.get_node("%HUD")
	var toolbox=hud.get_node("%Toolbox")
	var toolbar=hud.get_node("%FileToolbar")
	var puzzle_bar: PanelContainer = toolbar.get_node("%PuzzleBar")
	var authoring: PanelContainer = hud.get_node("%PuzzleAuthoring")
	var browser: Window = game.get_node("%PuzzleBrowser")
	var session: PuzzleSession=game.puzzle_session
	var levels=session.store.list_puzzles()
	session.store.progress.clear()
	game.handle_action("sandbox")
	await settle()
	assert_true(not hud.get_node("%Bottom").visible,"Idle sandbox has no instruction panel")
	assert_true(toolbox.size.y<650,"All-pieces toolbox stays bounded at 720p")
	await check_library_transitions(game,hud,toolbox)
	game.qa_example("bucket-elevator-demo")
	game.qa_select(1)
	await settle()
	var inspector=hud.get_node("%Inspector")
	assert_true(inspector.visible and inspector.size.y<420,"Mechanism selection has content-sized properties (%s)" % inspector.size)
	var gate = game.sandbox.build.spawn(game.catalog.get_piece("gate"), Transform3D(Basis.IDENTITY, Vector3(10, 0, 0)))
	game.sandbox.build.select(gate)
	await settle()
	var settings = inspector.get_node("%MechanismSettings")
	var number: SettingSlider = settings.get_child(0).get_node("%Value")
	number.value = 0.25
	assert_true(number.is_inside_tree(), "Slider edit keeps its control in the tree during the callback")
	await settle()
	assert_true(gate.configuration.delay == 0.25 and settings.get_child(0).get_node("%Value") == number, "Property edit preserves its original slider across frames")
	number.value = 0.5
	await settle()
	assert_true(inspector.visible and game.sandbox.build.selected == gate and gate.configuration.delay == 0.5, "Repeated property increments retain selection and the inspector")
	var release: BuildingPiece = game.sandbox.build.spawn(game.catalog.get_piece("sandbox-start"), Transform3D(Basis.IDENTITY, Vector3(14,0,0)))
	game.sandbox.build.select(release)
	await settle()
	var speed: SettingSlider = inspector.get_node("%Speed")
	assert_eq(speed.get_node("%Current").text, "1.4 m/s", "Launch slider shows its current speed")
	assert_eq(speed.get_node("%Minimum").text, "0 m/s")
	assert_eq(speed.get_node("%Maximum").text, "6 m/s")
	speed.value = 2.3
	await settle()
	assert_almost_eq(float(release.configuration.release_speed), 2.3, 0.001, "Launch slider edits the existing configuration")
	game.sandbox.build.select_all()
	await settle()
	assert_true(not inspector.visible,"Group selection has no redundant properties panel")
	assert_true(hud.get_node("%EditToolbar").get_node("%Raise").visible,"Group elevation stays in the contextual actions")
	assert_true(toolbar.get_node("LeftIsland").size.x<700,"Identity controls do not occupy the full viewport")
	var regular: Font=load("res://assets/font/nunito-sans/regular.tres")
	var bold: Font=load("res://assets/font/nunito-sans/bold.tres")
	assert_true(regular.get_string_size("Marble release").x!=bold.get_string_size("Marble release").x,"Native variable-font weights resolve distinctly")
	game.handle_action("menu")
	await settle()
	assert_true(game.menu_dialog.size.y>=250,"Mode menu has room for its visible actions")
	assert_true(game.menu_dialog.get_node("%New").visible and not game.menu_dialog.get_node("%Restart").visible,"Sandbox menu exposes file actions")
	game.menu_dialog.close()
	assert_true(game.sandbox.build.enabled,"Closing menu restores world input")
	session.player(levels[0])
	await settle()
	assert_true(not puzzle_bar.visible,"Campaign has no second puzzle panel")
	assert_true(toolbar.get_node("%SaveStatus").text=="Get the marble to the finish.","Campaign goal is concise")
	assert_true(toolbar.get_node("%Progress").text=="0 / 1 arrived","Delivery progress starts at zero")
	assert_true(not toolbar.get_node("%Save").visible,"Campaign has no track save action")
	assert_true(toolbox.buttons.size()==1 and toolbox.size.y<300,"Restricted inventory uses a single compact row (%s)" % toolbox.size)
	assert_true(toolbox.size.x<200,"One-piece inventory has no empty second column")
	assert_true(hud.get_node("%Guidance").visible,"Uncompleted Introduction provides guidance")
	game.sandbox.build.choose(game.catalog.get_piece("straight"))
	assert_true(hud.get_node("%GuidanceText").text=="Click a connector to attach.","Guidance advances when choosing a piece")
	hud.get_node("%DismissGuidance").pressed.emit()
	assert_true(not hud.get_node("%Guidance").visible,"Guidance can be dismissed")
	game.handle_action("menu")
	assert_true(game.menu_dialog.get_node("%Restart").visible and game.menu_dialog.get_node("%Levels").visible,"Campaign menu has restart and level select")
	for control in ["New","Rename","Load","Examples"]:
		assert_true(not game.menu_dialog.get_node("%"+control).visible,"Campaign hides "+control)
	game.menu_dialog.close()
	browser.open()
	browser.chapters.append({"id": "gut-empty-chapter", "name": "Empty workshop", "prerequisites": []})
	browser.show_chapter(browser.chapters.size() - 1)
	await settle()
	assert_true(not browser.get_node("%Levels").visible and browser.get_node("%Empty").visible,"Empty chapter has no empty list")
	assert_true(browser.size.y<450,"Empty chapter overlay contracts")
	assert_true(not game.sandbox.build.enabled,"Browser blocks world editing")
	game.handle_action("settings")
	await settle()
	assert_true(browser.visible and not game.settings_dialog.visible,"Settings cannot open over another exclusive dialog")
	browser.close()
	assert_true(game.sandbox.build.enabled,"Back restores world editing")
	session.editor(levels[0])
	authoring.open()
	await settle()
	assert_true(authoring is PanelContainer and game.sandbox.build.enabled,"Authoring drawer keeps the construction world available")
	for tab in authoring.get_node("%Tabs").get_tab_count():
		authoring.get_node("%Tabs").current_tab=tab
		await settle()
		assert_true(authoring.size.x<520,"Authoring page %d stays within the drawer" % tab)
	authoring.hide()
	game.handle_action("menu")
	assert_true(game.menu_dialog.get_node("%Author").visible and game.menu_dialog.get_node("%SaveDraft").visible,"Editor menu has authoring and draft actions")
	assert_true(not game.menu_dialog.get_node("%New").visible,"Editor excludes sandbox new-track action")
	game.menu_dialog.close()
	game.handle_action("settings")
	await settle()
	assert_true(game.settings_dialog.size.y<620,"Camera settings stay bounded")
	game.settings_dialog.get_node("%Tabs").current_tab=3
	await settle()
	assert_true(game.settings_dialog.size.y<700,"Controls reference fits 720p")
	game.settings_dialog.close()
	# Closing before the deferred content fit runs must not reopen the modal.
	game.handle_action("settings")
	game.settings_dialog.close()
	await settle()
	assert_true(not game.settings_dialog.visible and game.sandbox.build.enabled,"Closing settings cancels its deferred resize and restores world input")
	game.name_dialog.set_name_text("")
	assert_true(game.name_dialog.get_node("%Save").disabled,"Empty track names cannot be submitted")
	session.player(levels[0],true)
	game.handle_action("menu")
	assert_true(game.menu_dialog.get_node("%ReturnEditor").visible and not game.menu_dialog.get_node("%Levels").visible,"Player test returns to authoring")
	game.menu_dialog.close()
	game.sandbox.simulation.start()
	await settle()
	assert_true(not toolbox.visible and not hud.get_node("%BuildToolbar").visible,"Simulation retracts construction controls")
	assert_true(not toolbar.get_node("%Test").visible and toolbar.get_node("%Pause").visible,"Running simulation emphasizes pause")
	game.sandbox.simulation.reset()
	assert_true(toolbar.get_node("%Progress").text=="0 / 1 arrived","Reset refreshes delivery progress")
	game.queue_free()
	await settle()

func check_library_transitions(game: Node, hud: Control, toolbox: Control) -> void:
	var category: OptionButton=toolbox.get_node("%Category")
	var search: LineEdit=toolbox.get_node("%Search")
	var scroll: ScrollContainer=toolbox.get_node("%Scroll")
	var controls: Control=hud.get_node("%BuildToolbar").get_node("%Common")
	assert_true(category.selected==0,"All pieces remains the initial category")
	for resolution in [Vector2i(1280,720),Vector2i(1600,900),Vector2i(1920,1080)]:
		game.qa_resolution(resolution.x,resolution.y)
		await settle()
		var browser_position: Vector2=toolbox.global_position
		var browser_width: float=toolbox.size.x
		var card_size: Vector2=toolbox.buttons.values()[0].size
		var controls_rect: Rect2=controls.get_global_rect()
		var header_position: Vector2=search.global_position
		for index in [0,9,2,1]:
			category.select(index)
			category.item_selected.emit(index)
			await settle()
			assert_true(toolbox.global_position.is_equal_approx(browser_position) and search.global_position.is_equal_approx(header_position),"Category %d keeps the browser header stable at %s" % [index,resolution])
			assert_true(controls.get_global_rect().is_equal_approx(controls_rect),"Category %d keeps construction controls stable at %s" % [index,resolution])
			assert_true(is_equal_approx(toolbox.size.x,browser_width),"Browser width does not change with its scrollbar at %s" % resolution)
			for card in toolbox.buttons.values():
				assert_true(card.size.is_equal_approx(card_size),"Piece cards keep consistent dimensions at %s" % resolution)
		category.select(0)
		category.item_selected.emit(0)
		await settle()
		scroll.scroll_vertical=160
		var saved_scroll: int=scroll.scroll_vertical
		assert_true(saved_scroll>0,"All pieces scrolls at %s" % resolution)
		category.select(9)
		category.item_selected.emit(9)
		await settle()
		category.select(0)
		category.item_selected.emit(0)
		await settle()
		assert_true(scroll.scroll_vertical==saved_scroll,"Returning to a category restores its scroll at %s" % resolution)
		search.text="Paddle fan"
		search.text_changed.emit(search.text)
		await settle()
		assert_true(toolbox.buttons.size()==2,"Search finds the two paddle fans at %s" % resolution)
		toolbox.buttons[&"fan-simple-four"].pressed.emit()
		await settle()
		var chosen: PieceDefinition=game.sandbox.build.chosen
		assert_true(chosen.id==&"fan-simple-four","A card activates its stable piece ID")
		category.select(1)
		category.item_selected.emit(1)
		await settle()
		assert_true(game.sandbox.build.chosen==chosen,"Category browsing preserves active placement at %s" % resolution)
		assert_true(hud.get_node("%BuildToolbar").get_node("%ActivePiece").text.contains(chosen.display_name),"Active identity stays visible outside its category")
		var placement_rect: Rect2=controls.get_global_rect()
		hud.get_node("%BuildToolbar").get_node("%Library").pressed.emit()
		await settle()
		assert_true(not toolbox.visible and game.sandbox.build.chosen==chosen,"Collapse preserves active placement at %s" % resolution)
		assert_true(controls.get_global_rect().is_equal_approx(placement_rect),"Collapse does not move construction controls at %s" % resolution)
		hud.get_node("%BuildToolbar").get_node("%Library").pressed.emit()
		await settle()
		assert_true(toolbox.visible and category.selected==1 and search.text=="Paddle fan","Expand restores the same category and search")
		assert_true(controls.get_global_rect().is_equal_approx(placement_rect),"Expand does not move construction controls at %s" % resolution)
		search.text="no matching catalog item"
		search.text_changed.emit(search.text)
		await settle()
		assert_true(toolbox.buttons.is_empty() and toolbox.get_node("%Count").visible,"No-results state is explicit at %s" % resolution)
		assert_true(toolbox.global_position.is_equal_approx(browser_position),"No results does not move the browser at %s" % resolution)
		game.sandbox.build.cancel()
		search.clear()
		search.text_changed.emit(search.text)
		category.select(1)
		category.item_selected.emit(1)
		await settle()
	game.qa_resolution(1280,720)
	await settle()
