extends "res://tests/support/scene_test.gd"

func settle_motion() -> void:
	await wait_seconds(UIMotion.ENTER_TIME + UIMotion.EXIT_TIME + UIMotion.SCREEN_TIME)

func test_workspace_motion_preserves_build_and_handles_navigation_and_modals() -> void:
	var game: GameManager = load("res://scenes/main.tscn").instantiate()
	add_child_autoqfree(game)
	game.qa_resolution(1920, 1080)
	game.handle_action("sandbox")
	await settle_motion()
	var hud := game.workspace.hud
	var toolbox: Control = hud.get_node("%Toolbox")
	var toolbar: Control = hud.get_node("%BuildToolbar")
	var library: Button = toolbar.get_node("%Library")
	var search: LineEdit = toolbox.get_node("%Search")
	search.text = "Paddle fan"
	search.text_changed.emit(search.text)
	await get_tree().process_frame
	var layout := toolbar.get_rect()
	search.grab_focus()
	library.pressed.emit()
	assert_true(library.has_focus(), "Closing the library returns focus to its toggle")
	library.pressed.emit()
	library.pressed.emit()
	await settle_motion()
	assert_false(toolbox.visible)
	library.pressed.emit()
	await settle_motion()
	assert_true(toolbox.visible)
	assert_eq(search.text, "Paddle fan")
	assert_eq(toolbar.get_rect(), layout)
	game.qa_example("bucket-elevator-demo")
	await settle_motion()
	var baseline: Array = game.workspace.world.build.snapshot()
	library.pressed.emit()
	assert_true(game.workspace.world.simulation.start())
	await settle_motion()
	assert_false(toolbox.visible)
	assert_false(toolbar.visible)
	game.workspace.world.simulation.reset()
	await settle_motion()
	assert_true(toolbar.visible)
	assert_eq(game.workspace.world.build.snapshot(), baseline, "Mode motion preserves construction")
	game.handle_action("menu")
	await settle_motion()
	var dialog: Window = game.menu_dialog
	assert_false(game.workspace.world.build.enabled)
	dialog.close()
	dialog.close()
	assert_true(dialog.visible, "Modal remains open while its surface exits")
	assert_false(game.workspace.world.build.enabled)
	await settle_motion()
	assert_false(dialog.visible)
	assert_true(game.workspace.world.build.enabled)
	# External hiding must cancel a pending close action rather than execute it later.
	dialog.popup_centered()
	await settle_motion()
	var executed := [false]
	dialog.dismiss(func(): executed[0] = true)
	dialog.hide()
	await settle_motion()
	assert_false(executed[0])
	game.modal_closed()
	game.show_main_menu()
	game.workspace.activate()
	game.show_main_menu()
	await settle_motion()
	assert_true(game.get_node("%MainMenu").visible)
	assert_false(game.workspace.visible)
	assert_false(game.get_node("%NavigationFade").visible)
	game.workspace.activate()
	await settle_motion()
	assert_false(game.get_node("%MainMenu").visible)
	assert_true(game.workspace.world.build.enabled)
	assert_eq(game.workspace.hud.mouse_behavior_recursive, Control.MOUSE_BEHAVIOR_INHERITED)
	if DisplayServer.get_name() != "headless" and OS.get_environment("MARBLE_ENGINEER_UI_CAPTURE") == "1":
		hud.library_open = true
		hud.refresh()
		await settle_motion()
		await RenderingServer.frame_post_draw
		DirAccess.make_dir_recursive_absolute("res://build")
		assert_eq(get_viewport().get_texture().get_image().save_png("res://build/ui-motion.png"), OK)

func test_drawer_sections_notifications_and_modal_reopening() -> void:
	var game: GameManager = load("res://scenes/main.tscn").instantiate()
	add_child_autoqfree(game)
	game.qa_resolution(1920, 1080)
	var session := game.workspace.session
	session.editor(session.store.load_campaign().levels[0])
	await settle_motion()
	var drawer: PanelContainer = game.workspace.authoring
	drawer.open()
	await wait_seconds(UIMotion.ENTER_TIME * 0.3)
	assert_true(drawer.modulate.a > 0.0 and drawer.modulate.a < 1.0, "Drawer enters despite its initially hidden slot")
	drawer.close_drawer()
	drawer.open()
	await settle_motion()
	assert_true(drawer.visible)
	assert_eq(drawer.offset_transform_position_ratio, Vector2.ZERO)
	var tabs: TabContainer = drawer.get_node("%Tabs")
	for index in tabs.get_tab_count(): tabs.current_tab = index
	await settle_motion()
	assert_eq(tabs.get_current_tab_control().modulate.a, 1.0)
	drawer.close_drawer()
	await settle_motion()
	assert_false(drawer.visible)
	assert_false(game.workspace.hud.get_node("%AuthoringSlot").visible)
	assert_true(game.workspace.world.build.enabled)
	var hud := game.workspace.hud
	hud.show_status("Saved")
	hud.show_status("Updated")
	await settle_motion()
	assert_eq(hud.get_node("%Status").text, "Updated")
	assert_true(hud.get_node("%Bottom").visible)
	hud.get_node("%NotificationTimer").start(0.02)
	await settle_motion()
	assert_false(hud.get_node("%Bottom").visible, "Notification exits after the latest hold")
	game.handle_action("settings")
	await settle_motion()
	var settings: Window = game.settings_dialog
	settings.close()
	game.handle_action("settings")
	await settle_motion()
	assert_true(settings.visible and not settings.closing, "Reopening reverses an in-flight dismissal")
	assert_false(game.workspace.world.build.enabled)
	settings.close()
	await settle_motion()
	assert_true(game.workspace.world.build.enabled)

func test_completion_waits_for_modal_and_dismisses_before_reset() -> void:
	var game: GameManager = load("res://scenes/main.tscn").instantiate()
	add_child_autoqfree(game)
	game.qa_resolution(1920, 1080)
	var session := game.workspace.session
	session.player(session.store.load_campaign().levels[0])
	await settle_motion()
	game.handle_action("menu")
	await settle_motion()
	# Exercise UI lifecycle with a synthetic result; this is not a physics test.
	var simulation := game.workspace.world.simulation
	simulation.state = SimulationManager.State.SUCCESS
	var completion: Window = game.get_node("%PuzzleCompletion")
	completion.result(SimulationManager.State.SUCCESS, "")
	assert_false(completion.visible, "Completion waits while a menu is exclusive")
	game.menu_dialog.close()
	await settle_motion()
	assert_true(completion.visible)
	assert_false(game.workspace.world.build.enabled)
	completion.get_node("%KeepBuilding").pressed.emit()
	assert_eq(simulation.state, SimulationManager.State.SUCCESS, "Reset follows the modal exit")
	await settle_motion()
	assert_false(completion.visible)
	assert_eq(simulation.state, SimulationManager.State.BUILD)
	assert_true(game.workspace.world.build.enabled)
