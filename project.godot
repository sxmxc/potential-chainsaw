; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MarbleEngineer"
config/version="0.0.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SoundManager="*uid://b72a2q1fxu5yg"
PhantomCameraManager="*uid://duq6jhf6unyis"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/aspect="expand"
window/size/min_width=1024
window/size/min_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/sound_manager/plugin.cfg", "res://addons/yard/plugin.cfg")

[gui]

theme/custom="res://resources/sandbox_theme.tres"

[input]

build_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194305)]
}
build_remove={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194312)]
}
build_rotate={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":82)]
}
build_move_piece={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":77)]
}
build_select_tool={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":86)]
}
build_grid={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":71)]
}
build_snap={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":67)]
}
build_frame={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":70)]
}
build_frame_all={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194317)]
}
build_height_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194323)]
}
build_height_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194324)]
}
build_height_up_fine={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194323,"shift_pressed":true)]
}
build_height_down_fine={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194324,"shift_pressed":true)]
}
build_undo={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":90,"ctrl_pressed":true)]
}
build_redo={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":89,"ctrl_pressed":true), Object(InputEventKey,"keycode":90,"ctrl_pressed":true,"shift_pressed":true)]
}
build_duplicate={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":68,"ctrl_pressed":true)]
}
build_save_track={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":83,"ctrl_pressed":true)]
}
build_test_track={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":32)]
}
build_select_all={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":65,"ctrl_pressed":true)]
}
build_cycle_snap={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194306)]
}
camera_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
camera_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
camera_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
camera_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68)]
}

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"

[yard]

updates/channel="Prerelease"
