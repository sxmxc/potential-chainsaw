[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/mechanisms/diverter.gd" id="Script"]

[ext_resource type="PackedScene" path="res://assets/models/build_pieces/GLB format/split-double-sides.glb" id="Model"]

[ext_resource type="Shape3D" path="res://scenes/mechanisms/collision/split-double-sides.tres" id="TrackShape"]

[ext_resource type="Script" path="res://scripts/construction/piece_setting.gd" id="Setting"]

[sub_resource type="Resource" id="Setting_left"]
script = ExtResource("Setting")
key = &"left"
label = "Route left"
kind = 1
default_flag = false


[sub_resource type="Resource" id="Setting_alternating"]
script = ExtResource("Setting")
key = &"alternating"
label = "Alternate after crossing"
kind = 1
default_flag = false


[sub_resource type="PhysicsMaterial" id="TrackPhysics"]
friction = 0.18
bounce = 0.02

[sub_resource type="StandardMaterial3D" id="GuideMaterial"]
resource_local_to_scene = true
albedo_color = Color(0.5019608, 0.7254902, 0.6862745, 1)

[sub_resource type="BoxMesh" id="GuideMesh"]
size = Vector3(0.08, 0.48, 1.2)

[sub_resource type="PhysicsMaterial" id="GuidePhysics"]
friction = 0.05

[sub_resource type="BoxShape3D" id="GuideShape"]
size = Vector3(0.08, 0.48, 1.2)

[sub_resource type="BoxShape3D" id="DetectionShape"]
resource_local_to_scene = true
size = Vector3(2.6, 0.7, 1.6)

[node name="Diverter" type="Node3D" node_paths=PackedStringArray("guide", "area")]
script = ExtResource("Script")
