[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/mechanisms/gate.gd" id="Script"]

[ext_resource type="PackedScene" path="res://assets/models/build_pieces/GLB format/straight.glb" id="Model"]

[ext_resource type="Shape3D" path="res://scenes/mechanisms/collision/straight.tres" id="TrackShape"]

[ext_resource type="Script" path="res://scripts/construction/piece_setting.gd" id="Setting"]

[sub_resource type="Resource" id="Setting_delay"]
script = ExtResource("Setting")
key = &"delay"
label = "Open after"
description = "0 waits for a linked Open action."
default_number = 0.0
minimum = 0.0
maximum = 60.0
step = 0.25
unit = "s"


[sub_resource type="Resource" id="Setting_auto_close"]
script = ExtResource("Setting")
key = &"auto_close"
label = "Close after"
description = "0 keeps the gate open."
default_number = 0.0
minimum = 0.0
maximum = 60.0
step = 0.25
unit = "s"


[sub_resource type="Resource" id="Setting_open"]
script = ExtResource("Setting")
key = &"open"
label = "Initially open"
kind = 1
default_flag = false


[sub_resource type="PhysicsMaterial" id="TrackPhysics"]
friction = 0.18
bounce = 0.02

[sub_resource type="StandardMaterial3D" id="BarrierMaterial"]
resource_local_to_scene = true
albedo_color = Color(1, 0.7764706, 0.427451, 1)

[sub_resource type="BoxMesh" id="BarrierMesh"]
size = Vector3(0.48, 0.55, 0.1)

[sub_resource type="PhysicsMaterial" id="BarrierPhysics"]
friction = 0.05

[sub_resource type="BoxShape3D" id="BarrierShape"]
size = Vector3(0.48, 0.55, 0.1)

[sub_resource type="BoxShape3D" id="DetectionShape"]
resource_local_to_scene = true
size = Vector3(0.5, 0.75, 0.5)

[node name="Gate" type="Node3D" node_paths=PackedStringArray("barrier", "clearance")]
script = ExtResource("Script")
configuration_fields = Array[ExtResource("Setting")]([SubResource("Setting_delay"), SubResource("Setting_auto_close"), SubResource("Setting_open")])
barrier = NodePath("Barrier")
clearance = NodePath("Detection")

[node name="Track" type="StaticBody3D" parent="."]
physics_material_override = SubResource("TrackPhysics")
collision_layer = 1
collision_mask = 2

[node name="Model" parent="Track" instance=ExtResource("Model")]


[node name="Collision" type="CollisionShape3D" parent="Track"]
shape = ExtResource("TrackShape")

[node name="Barrier" type="AnimatableBody3D" parent="."]
position = Vector3(0, 0.525, 0)
physics_material_override = SubResource("BarrierPhysics")
collision_layer = 1
collision_mask = 2
sync_to_physics = false

[node name="Collision" type="CollisionShape3D" parent="Barrier"]
shape = SubResource("BarrierShape")

[node name="Visual" type="MeshInstance3D" parent="Barrier"]
mesh = SubResource("BarrierMesh")
material_override = SubResource("BarrierMaterial")

[node name="Detection" type="Area3D" parent="."]
position = Vector3(0, 0.6, 0)
collision_layer = 0
collision_mask = 2

[node name="Collision" type="CollisionShape3D" parent="Detection"]
shape = SubResource("DetectionShape")

[editable path="Track/Model"]
