[gd_scene format=3]

[ext_resource type="PackedScene" path="res://assets/models/build_pieces/GLB format/end-square.glb" id="Model"]

[ext_resource type="Shape3D" path="res://scenes/mechanisms/collision/end-square.tres" id="Shape"]

[ext_resource type="Script" path="res://scripts/mechanisms/marble_collector.gd" id="Behavior"]

[ext_resource type="Script" path="res://scripts/construction/piece_setting.gd" id="Setting"]
[ext_resource type="PackedScene" path="res://assets/models/build_pieces/GLB format/banner-high.glb" id="Banner"]

[sub_resource type="Resource" id="DisplayLabel"]
script = ExtResource("Setting")
key = &"display_label"
label = "Display label"
description = "Label shown above this collector"
kind = 2

[sub_resource type="PhysicsMaterial" id="Physics"]
friction = 0.18
bounce = 0.02

[sub_resource type="StandardMaterial3D" id="MarkerMaterial"]
albedo_color = Color(1, 0.7764706, 0.427451, 1)
emission_enabled = true
emission = Color(1, 0.7764706, 0.427451, 1)

[sub_resource type="TorusMesh" id="MarkerMesh"]
inner_radius = 0.24
outer_radius = 0.29

[sub_resource type="BoxShape3D" id="DetectionShape"]
size = Vector3(0.7, 0.7, 0.7)

[node name="Collector" type="Node3D" node_paths=PackedStringArray("area", "display_label")]
script = ExtResource("Behavior")
configuration_fields = Array[ExtResource("Setting")]([SubResource("DisplayLabel")])
area = NodePath("Detection")
display_label = NodePath("Track/Model/BillboardLabel3D")

[node name="Track" type="StaticBody3D" parent="."]
collision_layer = 1
collision_mask = 2
physics_material_override = SubResource("Physics")


[node name="Model" parent="Track" instance=ExtResource("Model")]

[node name="Banner" parent="Track/Model" instance=ExtResource("Banner")]
position = Vector3(0, 0.44176403, 0)

[node name="FinishLabel" type="Label3D" parent="Track/Model"]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 1.3, 0)
no_depth_test = true
text = "Finish"

[node name="BillboardLabel3D" type="Label3D" parent="Track/Model"]
position = Vector3(0, 1.6, 0)
visible = false
billboard = 1


[node name="Collision" type="CollisionShape3D" parent="Track"]
shape = ExtResource("Shape")

[node name="Marker" type="MeshInstance3D" parent="."]
position = Vector3(0, 0.72, 0)
mesh = SubResource("MarkerMesh")
material_override = SubResource("MarkerMaterial")

[editable path="Track/Model"]

[node name="Detection" type="Area3D" parent="."]
