[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/mechanisms/rotor_component.gd" id="Script"]

[ext_resource type="PackedScene" path="res://assets/models/build_pieces/GLB format/fan-simple-four.glb" id="Model"]

[ext_resource type="Shape3D" path="res://scenes/mechanisms/collision/fan-simple-four.tres" id="TrackShape"]

[ext_resource type="Script" path="res://scripts/construction/piece_setting.gd" id="Setting"]

[sub_resource type="Resource" id="Setting_angular_speed"]
script = ExtResource("Setting")
key = &"angular_speed"
label = "Paddle speed"
description = "Paddle speed (rad/s)"
default_number = 1.3
minimum = -6.0
maximum = 6.0
step = 0.1
unit = "rad/s"


[sub_resource type="Resource" id="Setting_enabled"]
script = ExtResource("Setting")
key = &"enabled"
label = "Initially spinning"
kind = 1
default_flag = true


[sub_resource type="PhysicsMaterial" id="TrackPhysics"]
friction = 0.18
bounce = 0.02

[sub_resource type="BoxShape3D" id="Blade0"]
size = Vector3(0.65, 0.15, 0.14)

[sub_resource type="BoxShape3D" id="Blade1"]
size = Vector3(0.14, 0.15, 0.65)

[node name="Paddle" type="Node3D" node_paths=PackedStringArray("mesh", "rotor")]
script = ExtResource("Script")
configuration_fields = Array[ExtResource("Setting")]([SubResource("Setting_angular_speed"), SubResource("Setting_enabled")])
mesh = NodePath("Track/Model/fan-simple-four/fan")
rotor = NodePath("Rotor")

[node name="Track" type="StaticBody3D" parent="."]
physics_material_override = SubResource("TrackPhysics")
collision_layer = 1
collision_mask = 2

[node name="Model" parent="Track" instance=ExtResource("Model")]


[node name="Collision" type="CollisionShape3D" parent="Track"]
shape = ExtResource("TrackShape")

[node name="Rotor" type="AnimatableBody3D" parent="."]
top_level = true
position = Vector3(0, 0.3, 0)
collision_layer = 1
collision_mask = 2
sync_to_physics = false

[node name="Blade0" type="CollisionShape3D" parent="Rotor"]
position = Vector3(0, 0.1, 0)
shape = SubResource("Blade0")

[node name="Blade1" type="CollisionShape3D" parent="Rotor"]
position = Vector3(0, 0.1, 0)
shape = SubResource("Blade1")

[editable path="Track/Model"]
